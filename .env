# Copy to .env and fill in, or export these in the shell before running
# manage.py - settings.py reads them straight from the environment.

DB_NAME=suryabooker
DB_USER=root
DB_PASSWORD=root
DB_HOST=127.0.0.1
DB_PORT=3303

# Hosts this server answers to, comma separated.
#
# Add this machine's LAN address to open the app from a phone on the same
# Wi-Fi, and start the server with `manage.py runserver 0.0.0.0:8000` so it
# listens beyond the loopback. The address changes when you change network.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],192.168.0.125

# Origins allowed to call the API, comma separated. The default covers the
# Vite dev server on both spellings of localhost; the LAN entry matches the
# host above, because the browser sends the origin it was opened from.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.0.125:5173
