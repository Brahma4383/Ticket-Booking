# Copy to .env and fill in, or export these in the shell before running
# manage.py - settings.py reads them straight from the environment.

DB_NAME=suryabooker
DB_USER=root
DB_PASSWORD=root
DB_HOST=127.0.0.1
DB_PORT=3303

# Hosts this server answers to, comma separated.
#
# Add this machine's LAN address to open the app from a phone on the same
# Wi-Fi, and start the server with `manage.py runserver 0.0.0.0:8000` so it
# listens beyond the loopback. The address changes when you change network.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],192.168.0.125

# Origins allowed to call the API, comma separated. The default covers the
# Vite dev server on both spellings of localhost; the LAN entry matches the
# host above, because the browser sends the origin it was opened from.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.0.125:5173

# Contact form mail. Left blank, the server prints the message to its own log
# instead of sending it, which is enough to develop against.
#
# For Gmail, EMAIL_HOST_PASSWORD must be a 16-character app password, not the
# account password, and two-factor authentication has to be on.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=true

# Who contact form messages are delivered to, and who they appear to be from.
CONTACT_INBOX=owner@shubhamtanks.com
DEFAULT_FROM_EMAIL=you@gmail.com

# How many messages one IP address may send. DRF's own rate syntax.
CONTACT_RATE_LIMIT=5/hour


# The support assistant behind the chat bubble. Entirely optional.
#
# Left blank, the assistant still works: it answers from its scripted intents
# and from the signed-in traveller's own bookings, which covers bookings,
# cancellations, refunds, payments and tickets, and costs nothing to run.
#
# Fill ANTHROPIC_API_KEY in and it also understands questions typed in any
# language and phrased any way, by handing what it cannot place to Claude.
# Remove the key later and it quietly goes back to the scripted answers.
# Needs `pip install anthropic`; without the package the key is ignored.
ANTHROPIC_API_KEY=
CHAT_AI_MODEL=claude-opus-5

# Messages one IP address may send per hour. Lower than you might expect
# because each one that reaches the model costs money.
CHAT_RATE_LIMIT=30/hour
