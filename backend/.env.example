# Copy to backend/.env and fill in. settings.py reads this file at startup;
# a variable already set in the real environment wins over it.
# backend/.env is gitignored - real passwords belong there, never in here.

# --- MySQL -------------------------------------------------------------------
DB_NAME=suryabooker
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Django ------------------------------------------------------------------
# A deployment must set both: a long random SECRET_KEY, and DEBUG=false.
SECRET_KEY=change-me-in-production
DEBUG=true

# Hosts this server answers to, comma separated. Add the machine's LAN address
# (and run `manage.py runserver 0.0.0.0:8000`) to open the app from a phone.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Origins allowed to call the API; the Vite dev server by default.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where the front end is served. Password reset emails link here.
FRONTEND_URL=http://localhost:5173

# --- Email -------------------------------------------------------------------
# Leave EMAIL_HOST empty and mail (contact form, password reset) is printed to
# the runserver console instead of sent. For Gmail, use an app password.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=demo@gmail.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=demo@gmail.com
CONTACT_INBOX=demo@gmail.com
CONTACT_RATE_LIMIT=5/hour

# --- Payments ------------------------------------------------------------------
# How long an unpaid booking holds its seats, berths or rooms.
PAYMENT_HOLD_MINUTES=15
PAYMENT_SWEEP_INTERVAL_SECONDS=30

# --- Password reset --------------------------------------------------------------
PASSWORD_RESET_TIMEOUT_MINUTES=60
PASSWORD_RESET_RATE_LIMIT=5/hour
PASSWORD_RESET_ACCOUNT_RATE_LIMIT=3/hour
PASSWORD_RESET_CONFIRM_RATE_LIMIT=30/hour

# --- Support chat (optional) -------------------------------------------------------
# With no key the assistant answers from its scripted replies only.
ANTHROPIC_API_KEY=
CHAT_AI_MODEL=claude-opus-5
CHAT_RATE_LIMIT=30/hour
